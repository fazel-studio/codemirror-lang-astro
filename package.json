{
  "name": "@fazelstudio/codemirror-lang-astro",
  "version": "0.2.0",
  "description": "Astro language support for the CodeMirror code editor",
  "license": "MIT",
  "author": "Zulfazli (Fazelllyyy)",
  "homepage": "https://github.com/fazelllyyy/codemirror-lang-astro#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fazelllyyy/codemirror-lang-astro.git"
  },
  "bugs": {
    "url": "https://github.com/fazelllyyy/codemirror-lang-astro/issues"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "editor",
    "astro",
    "lezer",
    "language",
    "syntax-highlighting"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "mocha test/test-astro.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.0.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.0",
    "@lezer/html": "^1.3.13",
    "@lezer/lr": "^1.4.10"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "mocha": "^10.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
